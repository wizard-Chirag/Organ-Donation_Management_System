<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Donor Requests</title>
</head>

<body>

    <h1>Donor Profile Requests</h1>

    <!-- =========================
         SEARCH AND FILTERS
    ========================== -->

    <section id="requestFilters">

        <label for="searchInput">Search:</label>

        <input
            type="text"
            id="searchInput"
            placeholder="Search by name or User ID"
            onkeyup="filterRequests()"
        >

        <br><br>

        <label for="genderFilter">Gender:</label>

        <select id="genderFilter" onchange="filterRequests()">
            <option value="">All</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>

    </section>

    <hr>


    <!-- =========================
         REQUEST LIST
    ========================== -->

    <section id="requestList">

        <% if (request.length === 0) { %>

            <p id="noRequestsMessage">
                No donor profile requests found.
            </p>

        <% } else { %>

            <% request.forEach(request => { %>

                <div
                    class="requestCard"
                    data-request-id="<%= request.donor_id %>"
                    data-user-id="<%= request.user_id %>"
                    data-name="<%= request.name %>"
                    data-gender="<%= request.gender %>"
                    data-dob="<%= request.date_of_birth %>"
                    data-blood-group="<%= request.blood_group %>"
                    data-hospital="<%= request.hospital_name %>"
                    data-document="<%= request.document_path %>"
                    onclick="openRequest(this)"
                >

                    <h3 class="requestName">
                        <%= request.name %>
                    </h3>

                    <p>
                        <strong>User ID:</strong>
                        <span class="requestUserId">
                            <%= request.user_id %>
                        </span>
                    </p>

                    <p>
                        <strong>Gender:</strong>
                        <span class="requestGender">
                            <%= request.gender %>
                        </span>
                    </p>

                    <p>
                        <strong>Hospital:</strong>
                        <span class="requestHospital">
                            <%= request.hospital_name %>
                        </span>
                    </p>

                </div>

                <hr>

            <% }) %>

        <% } %>

    </section>


    <!-- =========================
         REQUEST DETAILS MODAL
    ========================== -->

    <div id="requestModal">

        <div id="requestModalContent">

            <h2>Donor Request Details</h2>

            <p>
                <strong>Request ID:</strong>
                <span id="modalRequestId"></span>
            </p>

            <p>
                <strong>User ID:</strong>
                <span id="modalUserId"></span>
            </p>

            <p>
                <strong>Name:</strong>
                <span id="modalName"></span>
            </p>

            <p>
                <strong>Gender:</strong>
                <span id="modalGender"></span>
            </p>

            <p>
                <strong>Date of Birth:</strong>
                <span id="modalDob"></span>
            </p>

            <p>
                <strong>Blood Group:</strong>
                <span id="modalBloodGroup"></span>
            </p>

            <p>
                <strong>Hospital:</strong>
                <span id="modalHospital"></span>
            </p>

            <p>
                <strong>Document:</strong>
                <span id="modalDocument"></span>
            </p>

            <p>
                <a
                    id="documentLink"
                    href="#"
                    target="_blank"
                >
                    View Document
                </a>
            </p>


            <!-- ACTION BUTTONS -->

            <div id="requestActions">

                <button
                    type="button"
                    onclick="startAction('approve')"
                >
                    Approve
                </button>

                <button
                    type="button"
                    onclick="startAction('reject')"
                >
                    Reject
                </button>

                <button
                    type="button"
                    onclick="closeModal()"
                >
                    Close
                </button>

            </div>

        </div>

    </div>


    <!-- =========================
         PASSWORD CONFIRMATION
    ========================== -->

    <div id="passwordModal">

        <div id="passwordModalContent">

            <h2>Confirm Hospital Password</h2>

            <p>
                Enter your hospital password to continue.
            </p>

            <label for="hospitalPassword">
                Password:
            </label>

            <input
                type="password"
                id="hospitalPassword"
            >

            <p id="passwordError"></p>

            <button
                type="button"
                onclick="verifyPassword()"
            >
                Verify Password
            </button>

            <button
                type="button"
                onclick="cancelPassword()"
            >
                Cancel
            </button>

        </div>

    </div>


    <!-- =========================
         FINAL CONFIRMATION
    ========================== -->

    <div id="confirmationModal">

        <div id="confirmationModalContent">

            <h2>Final Confirmation</h2>

            <p id="confirmationMessage"></p>

            <button
                type="button"
                onclick="executeAction()"
            >
                Confirm
            </button>

            <button
                type="button"
                onclick="cancelConfirmation()"
            >
                Cancel
            </button>

        </div>

    </div>


    <!-- =========================
         INCORRECT PASSWORD
    ========================== -->

    <div id="incorrectPasswordModal">

        <div id="incorrectPasswordContent">

            <h2>Incorrect Password</h2>

            <p>
                The password you entered is incorrect.
            </p>

            <button
                type="button"
                onclick="incorrectPasswordClose()"
            >
                OK
            </button>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        let selectedRequestId = null;
        let selectedAction = null;


        /* =========================
           FILTER REQUESTS
        ========================== */

        function filterRequests() {

            const searchValue =
                document.getElementById("searchInput")
                    .value
                    .toLowerCase()
                    .trim();

            const genderValue =
                document.getElementById("genderFilter")
                    .value
                    .toLowerCase();

            const cards =
                document.querySelectorAll(".requestCard");

            cards.forEach(card => {

                const name =
                    card.dataset.name.toLowerCase();

                const userId =
                    card.dataset.userId.toLowerCase();

                const gender =
                    card.dataset.gender.toLowerCase();


                const searchMatch =
                    name.includes(searchValue) ||
                    userId.includes(searchValue);

                const genderMatch =
                    genderValue === "" ||
                    gender === genderValue;


                if (searchMatch && genderMatch) {

                    card.style.display = "block";

                } else {

                    card.style.display = "none";

                }

            });

        }


        /* =========================
           OPEN REQUEST
        ========================== */

        function openRequest(card) {

            selectedRequestId =
                card.dataset.requestId;


            document.getElementById("modalRequestId")
                .textContent =
                card.dataset.requestId;

            document.getElementById("modalUserId")
                .textContent =
                card.dataset.userId;

            document.getElementById("modalName")
                .textContent =
                card.dataset.name;

            document.getElementById("modalGender")
                .textContent =
                card.dataset.gender;

            document.getElementById("modalDob")
                .textContent =
                card.dataset.dob;

            document.getElementById("modalBloodGroup")
                .textContent =
                card.dataset.bloodGroup;

            document.getElementById("modalHospital")
                .textContent =
                card.dataset.hospital;

            document.getElementById("modalDocument")
                .textContent =
                card.dataset.document;


            document.getElementById("documentLink")
                .href =
                "/" + card.dataset.document;


            document.getElementById("requestModal")
                .style.display =
                "flex";

        }


        /* =========================
           CLOSE REQUEST MODAL
        ========================== */

        function closeModal() {

            document.getElementById("requestModal")
                .style.display =
                "none";

        }


        /* =========================
           START APPROVE / REJECT
        ========================== */

        function startAction(action) {

            if (!selectedRequestId) {

                return;

            }


            selectedAction = action;


            document.getElementById("passwordModal")
                .style.display =
                "flex";


            document.getElementById("hospitalPassword")
                .value = "";

            document.getElementById("passwordError")
                .textContent = "";

        }


        /* =========================
           CANCEL PASSWORD
        ========================== */

        function cancelPassword() {

            document.getElementById("passwordModal")
                .style.display =
                "none";

        }


        /* =========================
           VERIFY PASSWORD
        ========================== */

        async function verifyPassword() {

            const password =
                document.getElementById("hospitalPassword")
                    .value;


            if (password === "") {

                document.getElementById("passwordError")
                    .textContent =
                    "Please enter your password.";

                return;

            }


            try {

                const response =
                    await fetch(
                        "/hospital/profile-requests/verify-password",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({

                                password: password,

                                request_id:
                                    selectedRequestId,

                                action:
                                    selectedAction

                            })

                        }
                    );


                const result =
                    await response.json();


                if (result.success) {

                    document.getElementById("passwordModal")
                        .style.display =
                        "none";


                    showConfirmation();

                } else {

                    document.getElementById("passwordModal")
                        .style.display =
                        "none";


                    document.getElementById(
                        "incorrectPasswordModal"
                    ).style.display =
                        "flex";

                }

            } catch (error) {

                console.error(error);

                document.getElementById("passwordError")
                    .textContent =
                    "Something went wrong. Please try again.";

            }

        }


        /* =========================
           SHOW FINAL CONFIRMATION
        ========================== */

        function showConfirmation() {

            const actionText =
                selectedAction === "approve"
                    ? "approve"
                    : "reject";


            document.getElementById(
                "confirmationMessage"
            ).textContent =
                "Are you sure you want to " +
                actionText +
                " this donor profile request?";


            document.getElementById(
                "confirmationModal"
            ).style.display =
                "flex";

        }


        /* =========================
           CANCEL FINAL CONFIRMATION
        ========================== */

        function cancelConfirmation() {

            document.getElementById(
                "confirmationModal"
            ).style.display =
                "none";

        }


        /* =========================
           FINAL ACTION
        ========================== */

        async function executeAction() {

            if (!selectedRequestId ||
                !selectedAction) {

                return;

            }


            try {

                const response =
                    await fetch(
                        "/hospital/profile-requests/action",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({

                                request_id:
                                    selectedRequestId,

                                action:
                                    selectedAction

                            })

                        }
                    );


                const result =
                    await response.json();


                if (result.success) {

                    window.location.reload();

                } else {

                    alert(
                        result.message ||
                        "Action could not be completed."
                    );

                }

            } catch (error) {

                console.error(error);

                alert(
                    "Something went wrong. Please try again."
                );

            }

        }


        /* =========================
           INCORRECT PASSWORD CLOSE
        ========================== */

        function incorrectPasswordClose() {

            document.getElementById(
                "incorrectPasswordModal"
            ).style.display =
                "none";


            window.location.reload();

        }

    </script>

</body>
</html>