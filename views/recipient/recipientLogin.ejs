<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recipient Login</title>
</head>

<body>

    <h1>Recipient Login</h1>
<br><br><br>
    <form action="/recipient/login" method="POST">


    <input
        type="text"
        name="recipient_id"
        id="id"
        placeholder="Recipient ID"
        required
    >

    <br><br>

    <input
        type="password"
        name="password"
        id="password"
        placeholder="Profile Password"
        required
    >

    <br><br>

    <button type="submit" onclick="takeAction()">

        Login

    </button>
    <br><br>
    <a href="/recipient">Create New Profile</a>

    <br><br>
    <a href="/dashboard">Back to dashboard</a>

</form>

<% if (message) {%>
    <p style="color: red;">
        <%=message%>
    </p>

<%}%>

<hr>

<script>
    async function takeAction() {
        
        alert("I admit that the below credentials are valid");

        try {

            const password = document.getElementById("password").value            
            const id = document.getElementById("id").value

            const response = await fetch(
                "/recipient/login/action",

                {
                    method:"POST",

                    headers:
                        {
                            "Content-Type":
                                "application/json"
                        },

                    body:
                        JSON.stringify(
                            {
                                recipient_id:id,
                                password:password
                            }
                        )
                    
                }
            )

            const result = await response.json()

            if(result.success){
                alert(
                    result.message
                )
            }
        } catch (error) {
            
            alert(
                    result.message ||
                    "Unexpected error"
                );
        }
    }
</script>
</body>
</html>