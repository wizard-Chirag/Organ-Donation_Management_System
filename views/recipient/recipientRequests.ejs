<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Organ Requests | Recipient Portal</title>
    <style>
        :root {
            --bg-dark: #0b1120;
            --card-bg: rgba(15, 23, 42, 0.75);
            --card-border: rgba(148, 163, 184, 0.15);
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --modal-bg: rgba(15, 23, 42, 0.94);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            padding: 30px 20px;
            background-image: 
                radial-gradient(at 0% 0%, rgba(37, 99, 235, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(13, 148, 136, 0.1) 0px, transparent 50%);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Top Header */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--card-border);
        }

        .header-title h1 {
            font-size: 26px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
        }

        .header-title p {
            color: var(--text-muted);
            font-size: 14px;
            margin-top: 4px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            border: 1px solid transparent;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }
        .btn-primary:hover {
            background: var(--primary-hover);
        }

        .btn-secondary {
            background: rgba(30, 41, 59, 0.7);
            color: #e2e8f0;
            border-color: rgba(148, 163, 184, 0.2);
        }
        .btn-secondary:hover {
            background: rgba(51, 65, 85, 0.8);
            color: #fff;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.4);
        }
        .btn-danger:hover {
            background: #ef4444;
            color: #fff;
        }

        .btn-warning {
            background: rgba(245, 158, 11, 0.2);
            color: #fcd34d;
            border: 1px solid rgba(245, 158, 11, 0.4);
        }
        .btn-warning:hover {
            background: #f59e0b;
            color: #fff;
        }

        .btn-disabled {
            background: rgba(51, 65, 85, 0.4);
            color: #64748b;
            border: 1px solid rgba(71, 85, 105, 0.3);
            cursor: not-allowed;
            pointer-events: none;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 6px;
        }

        /* Banner Message */
        .alert-banner {
            background: rgba(37, 99, 235, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 10px;
            padding: 12px 18px;
            margin-bottom: 25px;
            color: #bfdbfe;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Filter Section */
        .filter-section {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        .search-box {
            flex: 1;
            min-width: 250px;
            position: relative;
        }
        .search-box input {
            width: 100%;
            padding: 10px 14px;
            background: #111c30;
            border: 1px solid #334155;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            outline: none;
        }
        .search-box input:focus {
            border-color: var(--primary);
        }

        .filter-select {
            padding: 10px 14px;
            background: #111c30;
            border: 1px solid #334155;
            border-radius: 8px;
            color: #cbd5e1;
            font-size: 14px;
            outline: none;
            cursor: pointer;
        }
        .filter-select:focus {
            border-color: var(--primary);
        }

        /* Grid */
        .organ-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 20px;
        }

        /* Card */
        .organ-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .organ-card:hover {
            transform: translateY(-3px);
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .organ-name-badge {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
        }
        .organ-id-pill {
            font-size: 12px;
            background: rgba(148, 163, 184, 0.15);
            color: #cbd5e1;
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 500;
        }

        /* Badges */
        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-pending {
            background: rgba(245, 158, 11, 0.15);
            color: #fcd34d;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }
        .status-approved {
            background: rgba(16, 185, 129, 0.15);
            color: #6ee7b7;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .status-rejected {
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .status-renewal {
            background: rgba(217, 119, 6, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(217, 119, 6, 0.4);
        }
        .status-withdrawn {
            background: rgba(148, 163, 184, 0.15);
            color: #94a3b8;
            border: 1px solid rgba(148, 163, 184, 0.3);
        }

        .priority-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(37, 99, 235, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.4);
            color: #93c5fd;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .priority-chip.crit-high {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.4);
            color: #fca5a5;
        }

        .matching-pill {
            display: inline-block;
            font-size: 12px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 6px;
            margin-bottom: 14px;
        }
        .matching-eligible {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .matching-not-eligible {
            background: rgba(148, 163, 184, 0.1);
            color: #94a3b8;
            border: 1px solid rgba(148, 163, 184, 0.2);
        }

        .card-details {
            font-size: 13px;
            color: #cbd5e1;
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }
        .card-detail-row {
            display: flex;
            justify-content: space-between;
        }
        .card-detail-label {
            color: var(--text-muted);
        }
        .card-detail-val {
            font-weight: 600;
            color: #f1f5f9;
        }

        .card-footer {
            padding-top: 12px;
            border-top: 1px solid rgba(148, 163, 184, 0.12);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: var(--card-bg);
            border: 1px dashed var(--card-border);
            border-radius: 16px;
        }
        .empty-state h3 {
            font-size: 20px;
            color: #fff;
            margin-bottom: 8px;
        }
        .empty-state p {
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        /* ═══════════════ MODAL OVERLAY & POPUP ═══════════════ */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
            overflow-y: auto;
        }
        .modal-overlay.active {
            display: flex;
        }

        .modal-container {
            background: var(--modal-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            max-width: 820px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            position: relative;
        }

        .modal-header {
            padding: 24px 28px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(10px);
            z-index: 10;
        }
        .modal-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .modal-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .close-btn {
            background: rgba(148, 163, 184, 0.1);
            border: none;
            color: #94a3b8;
            font-size: 22px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
        }
        .close-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        .modal-body {
            padding: 28px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .detail-section {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(148, 163, 184, 0.1);
            border-radius: 12px;
            padding: 18px 20px;
        }
        .detail-section h3 {
            font-size: 15px;
            font-weight: 700;
            color: #93c5fd;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 14px;
        }
        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .detail-label {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }
        .detail-val {
            font-size: 14px;
            color: #f1f5f9;
            font-weight: 600;
            word-break: break-word;
        }

        .retest-tag {
            color: #38bdf8;
            font-weight: 700;
        }

        .rejection-box {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            padding: 14px 16px;
            margin-top: 10px;
        }
        .rejection-box h4 {
            color: #fca5a5;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .rejection-box p {
            color: #fee2e2;
            font-size: 13px;
            line-height: 1.4;
        }

        .modal-footer {
            padding: 20px 28px;
            border-top: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            background: rgba(15, 23, 42, 0.9);
        }

        /* Cancellation Confirmation Modal */
        .confirm-modal-box {
            background: var(--modal-bg);
            border: 1px solid rgba(239, 68, 68, 0.4);
            border-radius: 16px;
            max-width: 480px;
            width: 100%;
            padding: 26px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
            text-align: left;
        }
        .confirm-modal-box h3 {
            color: #fca5a5;
            font-size: 18px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .confirm-modal-box p {
            font-size: 13px;
            color: #cbd5e1;
            line-height: 1.5;
            margin-bottom: 18px;
        }
        .confirm-modal-box input[type="password"] {
            width: 100%;
            padding: 10px 14px;
            background: #111c30;
            border: 1px solid #334155;
            border-radius: 8px;
            color: #fff;
            margin-bottom: 18px;
            outline: none;
        }
        .confirm-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
    </style>
</head>

<body>

<div class="container">

    <!-- Top Navigation Header -->
    <header class="page-header">
        <div class="header-title">
            <h1>
                <span>🫀 My Requested Organs</span>
            </h1>
            <p>
                Recipient ID: <strong><%= recipient.recipient_id %></strong> &bull; 
                <%= user.name %> (<%= user.gender || 'Recipient' %>, <%= user.bloodgroup ? 'Blood Group: ' + user.bloodgroup : '' %>)
            </p>
        </div>
        <div class="header-actions">
            <a href="/recipient/organ" class="btn btn-primary">
                + Request New Organ
            </a>
            <a href="/recipient/dashboard" class="btn btn-secondary">
                &larr; Recipient Dashboard
            </a>
        </div>
    </header>

    <!-- Message Alert Banner if any -->
    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert-banner">
            <span><%= message %></span>
            <button onclick="this.parentElement.remove()" style="background:none; border:none; color:#93c5fd; font-size:18px; cursor:pointer;">&times;</button>
        </div>
    <% } %>

    <!-- Filter & Search Controls -->
    <div class="filter-section">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Search by organ, hospital, or request ID..." oninput="applyFilters()">
        </div>

        <select id="organFilter" class="filter-select" onchange="applyFilters()">
            <option value="">All Organs</option>
            <% organs.forEach(org => { %>
                <option value="<%= org.organ_name.toLowerCase() %>"><%= org.organ_name %></option>
            <% }); %>
        </select>

        <select id="statusFilter" class="filter-select" onchange="applyFilters()">
            <option value="">All Statuses</option>
            <option value="pending">Pending Approval</option>
            <option value="approved">Approved</option>
            <option value="renewal required">Renewal Required</option>
            <option value="rejected">Rejected</option>
            <option value="withdrawn">Withdrawn</option>
        </select>

        <button class="btn btn-secondary btn-sm" onclick="resetFilters()">Reset</button>
    </div>

    <!-- Organ Requests Grid -->
    <div class="organ-grid" id="organGrid">
        <% if (requests && requests.length > 0) { %>
            <% requests.forEach(function(item) { 
                const isWithdrawn = item.verification_status === 'Withdrawn' || item.request_status === 'Withdrawn';
                const isPending = item.verification_status === 'Pending' && !isWithdrawn;
                const isApproved = item.verification_status === 'Approved' && !isWithdrawn;
                const isRenewalReq = item.verification_status === 'Renewal Required' && !isWithdrawn;
                const isRejected = item.verification_status === 'Rejected' && !isWithdrawn;

                let statusClass = 'status-pending';
                let displayStatus = item.verification_status;
                if (isWithdrawn) {
                    statusClass = 'status-withdrawn';
                    displayStatus = 'Withdrawn';
                } else if (isApproved) {
                    statusClass = 'status-approved';
                } else if (isRenewalReq) {
                    statusClass = 'status-renewal';
                } else if (isRejected) {
                    statusClass = 'status-rejected';
                }

                const score = item.calculated_priority_score || item.criticality_score || 0;
            %>
                <div class="organ-card" 
                     id="organ-card-<%= item.or_id %>"
                     data-id="<%= item.or_id %>"
                     data-organ="<%= item.organ_name.toLowerCase() %>"
                     data-status="<%= isWithdrawn ? 'withdrawn' : item.verification_status.toLowerCase() %>"
                     data-text="<%= (item.organ_name + ' ' + (item.hospital_name || '') + ' ' + item.or_id).toLowerCase() %>"
                     onclick="handleCardClick(this)">
                    
                    <div>
                        <div class="card-top">
                            <div class="organ-name-badge">
                                <span><%= item.organ_name %></span>
                                <br><br><span style="font-size: small;">Request ID:</span>
                                <span class="organ-id-pill">#<%= item.or_id %></span>
                            </div>
                            <span class="status-badge <%= statusClass %>"><%= displayStatus %></span>
                        </div>

                        <!-- Priority Chip -->
                        <div class="priority-chip <%= score >= 10 ? 'crit-high' : '' %>">
                            ⚡ Priority: <%= score %> pts
                            <% if (item.renewal_priority_bonus > 0) { %>
                                <span style="font-size:11px; opacity:0.85;">(+<%= item.renewal_priority_bonus %> bonus)</span>
                            <% } %>
                        </div>

                        <!-- Eligibility pill -->
                        <% if (isWithdrawn) { %>
                            <div class="matching-pill matching-not-eligible" style="color:#f87171; border-color:rgba(239,68,68,0.3);">
                                &bull; Withdrawn (Unavailable & Unreachable)
                            </div>
                        <% } else if (item.is_eligible_for_matching) { %>
                            <div class="matching-pill matching-eligible">
                                &bull; Eligible for Matching
                            </div>
                        <% } else if (isRenewalReq) { %>
                            <div class="matching-pill matching-not-eligible" style="color:#fbbf24; border-color:rgba(245,158,11,0.4);">
                                &bull; ⏰ Auto-Expired (Renewal Required)
                            </div>
                        <% } else { %>
                            <div class="matching-pill matching-not-eligible">
                                &bull; <%= isPending ? 'Pending Hospital Verification (+2 pts/day)' : 'Not Eligible for Matching' %>
                            </div>
                        <% } %>

                        <div class="card-details">
                            <div class="card-detail-row">
                                <span class="card-detail-label">Assigned Hospital:</span>
                                <span class="card-detail-val"><%= item.hospital_name || 'Assigned Hospital' %></span>
                            </div>
                            <div class="card-detail-row">
                                <span class="card-detail-label">Renewal Cycles:</span>
                                <span class="card-detail-val"><%= item.request_count || 0 %> renewals</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <span>Submitted: <%= new Date(item.registered_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                        <span style="color:#60a5fa; font-weight:600;">View Details &rarr;</span>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state">
                <h3>No Organ Requests Found</h3>
                <p>You have not created any organ requests yet. Submit a request to enter the recipient matching queue.</p>
                <a href="/recipient/organ" class="btn btn-primary">+ Request an Organ Now</a>
            </div>
        <% } %>
    </div>

</div>

<!-- ═══════════════ GLASSMORPHISM DETAILS MODAL ═══════════════ -->
<div class="modal-overlay" id="detailsModalOverlay" onclick="handleOverlayClick(event)">
    <div class="modal-container">
        <div class="modal-header">
            <div>
                <h2 id="modalOrganTitle">Organ Request</h2>
                <div class="modal-subtitle" id="modalSubtitle">Request details and verification status</div>
            </div>
            <button class="close-btn" onclick="closeDetailsModal()">&times;</button>
        </div>

        <div class="modal-body">
            <!-- Section 1: Request Status & Priority Scoring -->
            <div class="detail-section">
                <h3>⚡ Status & Priority Scoring</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Verification Status</span>
                        <div class="detail-val" id="modalVerificationStatus">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Matching Eligibility</span>
                        <div class="detail-val" id="modalMatchingEligibility">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Total Priority Score</span>
                        <div class="detail-val" id="modalPriorityScore" style="color:#60a5fa; font-weight:700;">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Renewal Cycles</span>
                        <div class="detail-val" id="modalCycles">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Registered Date</span>
                        <div class="detail-val" id="modalRegisteredAt">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Daily Waiting Bonus</span>
                        <div class="detail-val" id="modalDailyBonus">+2 points per day</div>
                    </div>
                </div>

                <!-- Rejection or Renewal Reason Box -->
                <div class="rejection-box" id="modalRejectionReasonBox" style="display:none;">
                    <h4 id="modalReasonTitle">Notice / Reason:</h4>
                    <p id="modalRejectionReasonText"></p>
                </div>
            </div>

            <!-- Section 2: Hospital & Verification Dates -->
            <div class="detail-section">
                <h3>🏥 Hospital Verification & Medical Records</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Verifying Hospital</span>
                        <div class="detail-val" id="modalHospitalName">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Hospital Location</span>
                        <div class="detail-val" id="modalHospitalCity">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Hospital Approval Date</span>
                        <div class="detail-val" id="modalTestDate">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Re-Testing / Review Date</span>
                        <div class="detail-val" id="modalRetestDate">-</div>
                    </div>
                    <div class="detail-item" style="grid-column: 1 / -1;">
                        <span class="detail-label">Medical Proof Document</span>
                        <div class="detail-val" id="modalDocLink">-</div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Recipient Primary Details -->
            <div class="detail-section">
                <h3>👤 Recipient Profile Information</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Recipient Name</span>
                        <div class="detail-val" id="modalRecipientName">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Profile IDs</span>
                        <div class="detail-val" id="modalRecipientIds">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Gender</span>
                        <div class="detail-val" id="modalRecipientGender">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Blood Group</span>
                        <div class="detail-val" id="modalRecipientBlood">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Contact Phone</span>
                        <div class="detail-val" id="modalRecipientPhone">-</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Email</span>
                        <div class="detail-val" id="modalRecipientEmail">-</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <div id="modalActionNote" style="font-size:12px; color:var(--text-muted); max-width:440px;"></div>
            <div style="display:flex; gap:10px; align-items:center;">
                <!-- Renew Button (enabled ONLY when Renewal Required) -->
                <a href="#" class="btn btn-warning btn-sm" id="modalRenewBtn" style="display:none;">
                    ⚡ Renew Request (+5 Priority Boost)
                </a>

                <!-- Request New Organ Button (for rejected requests) -->
                <a href="/recipient/organ" class="btn btn-primary btn-sm" id="modalNewRequestBtn" style="display:none;">
                    + Create New Request
                </a>

                <!-- Cancel Request Button -->
                <button type="button" class="btn btn-danger btn-sm" id="modalCancelBtn" onclick="promptCancelRequest()">
                    Cancel Request
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ CANCEL CONFIRMATION POPUP ═══════════════ -->
<div class="modal-overlay" id="cancelConfirmOverlay" onclick="handleCancelOverlayClick(event)">
    <div class="confirm-modal-box">
        <h3>⚠️ Confirm Request Cancellation</h3>
        <p>
            Are you sure you want to cancel and withdraw this organ request? Once withdrawn, it is marked as unavailable and unreachable. Any pending hospital notifications will be removed, and the request cannot be approved.
        </p>
        <form id="cancelConfirmForm" onsubmit="submitCancelRequest(event)">
            <label for="cancelPasswordInput" style="display:block; font-size:12px; font-weight:600; color:#cbd5e1; margin-bottom:6px;">
                Recipient Profile Password Required:
            </label>
            <input type="password" id="cancelPasswordInput" placeholder="Enter recipient profile password" required>
            
            <div class="confirm-modal-actions">
                <button type="button" class="btn btn-secondary btn-sm" onclick="closeCancelConfirmModal()">Keep Request</button>
                <button type="submit" class="btn btn-danger btn-sm" id="confirmCancelSubmitBtn">Confirm & Withdraw</button>
            </div>
        </form>
    </div>
</div>

<!-- Embedded JSON Data payload -->
<script type="application/json" id="recipientRequestsJson">
    <%- JSON.stringify(requests || []) %>
</script>

<script>
    const recipientRequestsRaw = document.getElementById('recipientRequestsJson');
    const recipientRequestsData = recipientRequestsRaw ? JSON.parse(recipientRequestsRaw.textContent || '[]') : [];
    const recipientRequestsMap = {};
    recipientRequestsData.forEach(function(item) {
        recipientRequestsMap[item.or_id] = item;
    });

    function handleCardClick(cardEl) {
        if (!cardEl) return;
        const id = cardEl.getAttribute('data-id');
        if (id) {
            openDetailsModalById(id);
        }
    }

    function openDetailsModalById(id) {
        const item = recipientRequestsMap[id];
        if (item) {
            openDetailsModal(item);
        }
    }

    let currentSelectedRequest = null;

    function openDetailsModal(item) {
        currentSelectedRequest = item;

        const isWithdrawn = item.verification_status === 'Withdrawn' || item.request_status === 'Withdrawn';
        const isPending = item.verification_status === 'Pending' && !isWithdrawn;
        const isApproved = item.verification_status === 'Approved' && !isWithdrawn;
        const isRenewalReq = item.verification_status === 'Renewal Required' && !isWithdrawn;
        const isRejected = item.verification_status === 'Rejected' && !isWithdrawn;

        // Title
        document.getElementById('modalOrganTitle').innerHTML = `${item.organ_name} <span class="organ-id-pill">Request #${item.or_id}</span>`;
        document.getElementById('modalSubtitle').innerText = `Registered on ${new Date(item.registered_at).toLocaleString()}`;

        // Section 1: Verification Status & Eligibility
        const verifEl = document.getElementById('modalVerificationStatus');
        let statusBadgeClass = 'status-pending';
        let statusText = item.verification_status;
        if (isWithdrawn) { statusBadgeClass = 'status-withdrawn'; statusText = 'Withdrawn'; }
        else if (isApproved) { statusBadgeClass = 'status-approved'; }
        else if (isRenewalReq) { statusBadgeClass = 'status-renewal'; statusText = 'Renewal Required (Expired)'; }
        else if (isRejected) { statusBadgeClass = 'status-rejected'; }
        verifEl.innerHTML = `<span class="status-badge ${statusBadgeClass}">${statusText}</span>`;

        const matchEl = document.getElementById('modalMatchingEligibility');
        if (isWithdrawn) {
            matchEl.innerHTML = `<span style="color:#f87171; font-weight:700;">&bull; Withdrawn (Unavailable & Unreachable)</span>`;
        } else if (item.is_eligible_for_matching) {
            matchEl.innerHTML = `<span style="color:#34d399; font-weight:700;">&bull; Eligible for Matching</span>`;
        } else if (isRenewalReq) {
            matchEl.innerHTML = `<span style="color:#fbbf24; font-weight:700;">&bull; Auto-Expired (Renewal Required)</span>`;
        } else {
            matchEl.innerHTML = `<span style="color:#94a3b8;">&bull; ${isPending ? 'Pending Hospital Verification' : 'Not Eligible'}</span>`;
        }

        const score = item.calculated_priority_score || item.criticality_score || 0;
        const baseScore = item.base_criticality_score || 0;
        const renewalBonus = item.renewal_priority_bonus || 0;
        let scoreBreakdown = `Base: ${baseScore} pts + 2 pts/day`;
        if (renewalBonus > 0) scoreBreakdown += ` + ${renewalBonus} renewal bonus`;
        document.getElementById('modalPriorityScore').innerText = `${score} points (${scoreBreakdown})`;
        document.getElementById('modalCycles').innerText = `${item.request_count || 0} renewals completed`;
        document.getElementById('modalRegisteredAt').innerText = new Date(item.registered_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

        // Reason box
        const rejBox = document.getElementById('modalRejectionReasonBox');
        if (item.rejection_reason) {
            rejBox.style.display = 'block';
            document.getElementById('modalReasonTitle').innerText = isRenewalReq ? "Auto-Expiry Notice:" : "Hospital Reason:";
            document.getElementById('modalRejectionReasonText').innerText = item.rejection_reason;
        } else {
            rejBox.style.display = 'none';
        }

        // Section 2: Hospital & Dates
        document.getElementById('modalHospitalName').innerText = `${item.hospital_name || 'Assigned Hospital'} (${item.verified_hospital_id || 'N/A'})`;
        document.getElementById('modalHospitalCity').innerText = item.hospital_city || 'Not specified';

        const testDateStr = item.verified_at ? new Date(item.verified_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Awaiting hospital action';
        document.getElementById('modalTestDate').innerText = testDateStr;

        const retestDateStr = item.retest_date ? new Date(item.retest_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'N/A';
        document.getElementById('modalRetestDate').innerHTML = item.retest_date ? `<span class="retest-tag">${retestDateStr}</span> (1 Month Review Window)` : 'N/A';

        if (item.medical_proof_path) {
            document.getElementById('modalDocLink').innerHTML = `<a href="/${item.medical_proof_path}" target="_blank" style="color:#60a5fa; text-decoration:underline; font-weight:600;">View Medical Proof Document &rarr;</a>`;
        } else {
            document.getElementById('modalDocLink').innerText = 'No document uploaded';
        }

        // Section 3: Recipient details
        document.getElementById('modalRecipientName').innerText = item.recipient_name || 'Recipient';
        document.getElementById('modalRecipientIds').innerText = `Recipient ID: ${item.recipient_id} | User ID: ${item.user_id}`;
        document.getElementById('modalRecipientGender').innerText = (item.recipient_gender ? item.recipient_gender.toUpperCase() : 'N/A');
        document.getElementById('modalRecipientBlood').innerText = item.bloodgroup || 'N/A';
        document.getElementById('modalRecipientPhone').innerText = item.recipient_phone || 'N/A';
        document.getElementById('modalRecipientEmail').innerText = item.recipient_email || 'N/A';

        // Action Buttons Logic
        const renewBtn = document.getElementById('modalRenewBtn');
        const newReqBtn = document.getElementById('modalNewRequestBtn');
        const cancelBtn = document.getElementById('modalCancelBtn');
        const noteEl = document.getElementById('modalActionNote');

        // Specification 2:
        // "the user cannot update or renew his request untill the hospital action is pending unlike the cancellation of request option which he can do anytime... the user must be blocked from updating request details and only be allowed when the hospital no action renewal option is given."
        if (isWithdrawn) {
            renewBtn.style.display = 'none';
            newReqBtn.style.display = 'none';
            cancelBtn.style.display = 'none';
            noteEl.innerHTML = '<span style="color:#f87171; font-weight:600;">This organ request has been withdrawn/cancelled. No further modifications or reviews can be made.</span>';
        } else if (isRenewalReq) {
            renewBtn.style.display = 'inline-flex';
            renewBtn.href = `/recipient/organ/${item.or_id}/renew`;
            newReqBtn.style.display = 'none';
            cancelBtn.style.display = 'inline-flex';
            noteEl.innerHTML = '<span style="color:#fbbf24; font-weight:600;">Hospital took no action within 3 days. Renew now to resubmit with an extra +5 priority boost.</span>';
        } else if (isPending) {
            renewBtn.style.display = 'none';
            newReqBtn.style.display = 'none';
            cancelBtn.style.display = 'inline-flex';
            noteEl.innerText = 'Request is currently pending hospital review. You cannot update details while pending, but you can cancel at any time.';
        } else if (isApproved) {
            renewBtn.style.display = 'none';
            newReqBtn.style.display = 'none';
            cancelBtn.style.display = 'inline-flex';
            noteEl.innerText = 'Request is approved and active for matching. You may withdraw the request if no longer needed.';
        } else if (isRejected) {
            renewBtn.style.display = 'none';
            newReqBtn.style.display = 'inline-flex';
            cancelBtn.style.display = 'none';
            noteEl.innerText = 'Request was rejected. You are entitled to initiate a new organ request.';
        } else {
            renewBtn.style.display = 'none';
            newReqBtn.style.display = 'none';
            cancelBtn.style.display = 'none';
            noteEl.innerText = '';
        }

        document.getElementById('detailsModalOverlay').classList.add('active');
    }

    function closeDetailsModal() {
        document.getElementById('detailsModalOverlay').classList.remove('active');
    }

    function handleOverlayClick(event) {
        if (event.target.id === 'detailsModalOverlay') {
            closeDetailsModal();
        }
    }

    // Cancel prompt
    function promptCancelRequest() {
        if (!currentSelectedRequest) return;
        document.getElementById('cancelPasswordInput').value = '';
        document.getElementById('cancelConfirmOverlay').classList.add('active');
    }

    function closeCancelConfirmModal() {
        document.getElementById('cancelConfirmOverlay').classList.remove('active');
    }

    function handleCancelOverlayClick(event) {
        if (event.target.id === 'cancelConfirmOverlay') {
            closeCancelConfirmModal();
        }
    }

    async function submitCancelRequest(event) {
        event.preventDefault();
        if (!currentSelectedRequest) return;

        const password = document.getElementById('cancelPasswordInput').value;
        const submitBtn = document.getElementById('confirmCancelSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.innerText = 'Cancelling...';

        try {
            const response = await fetch(`/recipient/organ/${currentSelectedRequest.or_id}/cancel`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ recipient_password: password })
            });

            const result = await response.json();

            if (result.success) {
                alert('Success: ' + result.message);
                window.location.reload();
            } else {
                alert('Error: ' + (result.message || 'Failed to cancel organ request'));
                submitBtn.disabled = false;
                submitBtn.innerText = 'Confirm & Withdraw';
            }
        } catch (err) {
            console.error('Cancellation error:', err);
            alert('Server error occurred during cancellation.');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Confirm & Withdraw';
        }
    }

    // Filters
    function applyFilters() {
        const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
        const organVal = document.getElementById('organFilter').value;
        const statusVal = document.getElementById('statusFilter').value;

        const cards = document.querySelectorAll('.organ-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const organ = card.getAttribute('data-organ');
            const status = card.getAttribute('data-status');
            const text = card.getAttribute('data-text');

            const matchesSearch = !searchVal || text.includes(searchVal);
            const matchesOrgan = !organVal || organ === organVal;
            const matchesStatus = !statusVal || status === statusVal;

            if (matchesSearch && matchesOrgan && matchesStatus) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
    }

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('organFilter').value = '';
        document.getElementById('statusFilter').value = '';
        applyFilters();
    }
</script>

</body>
</html>
