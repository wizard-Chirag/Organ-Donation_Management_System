<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donor Login</title>
</head>

<body>

    <h1>Donor Login</h1>
<br><br><br>
    <form action="/donor/login" method="POST">


    <input
        type="text"
        name="donor_id"
        id="id"
        placeholder="Donor ID"
        required
    >

    <br><br>

    <input
        type="password"
        name="password"
        id="password"
        placeholder="Profile Password"
        required
    >

    <br><br>

    <button type="submit" onclick="takeAction(event)">
        Login
    </button>
    <br><br>
    <a href="/donor">Create New Profile</a>

    <br><br>
    <a href="/dashboard">Back to dashboard</a>

</form>

<% if (message) {%>
    <p style="color: red;">
        <%=message%>
    </p>
<%}%>

<hr>

<script>
    async function takeAction(event) {
        if (event) {
            event.preventDefault();
        }

        try {
            const password = document.getElementById("password").value;
            const id = document.getElementById("id").value;

            if (!id || !password) {
                alert("Please enter both Donor ID and Password");
                return;
            }

            const response = await fetch("/donor/login/action", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    donor_id: id,
                    password: password
                })
            });

            const result = await response.json();

            if (result.success) {
                alert(result.message);
                window.location.href = result.redirectUrl || "/donor";
            } else {
                alert(result.message || "Invalid credentials");
            }
        } catch (error) {
            console.error(error);
            alert("Unexpected error during login. Please try again.");
        }
    }
</script>
</body>

</html>