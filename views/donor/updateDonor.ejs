<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Update Donor Profile</title>
</head>

<body>

    <h1>Update Donor Profile</h1>

    <hr>

    <!-- <h3>User Information</h3>

    <p><strong>Name :</strong> <%= user.name %></p>
    <p><strong>Email :</strong> <%= user.email %></p>
    <p><strong>Phone :</strong> <%= user.phone_number %></p>
    <p><strong>Blood Group :</strong> <%= user.blood_group %></p>

    <hr> -->

    <form action="/donor/update" method="POST" enctype="multipart/form-data" onsubmit="return submiter()">

        <label>Registered Hospital</label>

        <br><br>

        <select name="hospital_id" required>

            <option value="">Select Hospital</option>

            <% hospitals.forEach(hospital => { %>

                <option value="<%= hospital.hospital_id %>">

                    <%= hospital.hospital_name %>

                </option>

            <% }) %>

        </select>

        <br><br>

        <label>Medical Report</label>

        <br><br>

        <input
            type="file"
            name="medical_report"
            accept=".pdf,.jpg,.jpeg,.png"
            required
        >

        <br><br>

        <label>Confirm User Password</label>

        <br><br>

        <input
            type="password"
            name="password"
            required
        >

        <br><br>

        <button type="submit">
            Update Donor Profile
        </button>

    </form>

    <br>

    <a href="/dashboard">
        Back to Dashboard
    </a>

</body>

</html>

<script>
    function submiter() {
        return confirm("I agree that the details updated by me for donor registration are valid");
    }
</script>