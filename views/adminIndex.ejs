<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>Register</h2>

<form action="/adminAnthamma" method="POST">

    <input
        type="text"
        name="id"
        placeholder="Hospitalid"
        required
    >

    <br><br>
    <input
        type="text"
        name="name"
        placeholder="HospitalName"
        required
    >

    <br><br>

    <input
        type="email"
        name="email"
        placeholder="Email"
        required
    >

    <br><br>

    <input
        type="text"
        name="license_number"
        placeholder="licence Number"
        required
    >

    <br><br>

    <input
        type="password"
        name="password"
        placeholder="Password"
        required
    >

    <br><br>

    <input
        type="number"
        name="transplant_beds"
        placeholder="No of transplant beds"
        required
    >

    <br><br>

    <input
        type="text"
        name="city"
        placeholder="city"
        required
    >

    <br><br>

     <input
        type="number"
        name="contact_number"
        placeholder="contact number"
        required
    >

    <br><br>

   <select name="status">
<option >select Status</option>
<option value="Active">Active</option>
<option value="Inactive">Inactive</option>
   </select>
    <!-- <br><br> -->

    <button type="submit">

        Register

    </button>

</form>
</body>
</html>