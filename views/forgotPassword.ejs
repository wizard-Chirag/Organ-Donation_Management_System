<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
</head>

<body>
    <h2>Reset Password</h2>
    <form action="/forgotPassword" method="post">
        <ul style="list-style: none;">
            <li>
                <label>Enter your email</label><br><br>
                <input type="email" name="email" required>
            </li>
            <li>
                <br><label>Enter your phone number</label><br><br>
                <input type="number" name="phonenumber" required>
            </li>
            <li>
                <br><label>Enter your User password</label><br><br>
                <input type="password" name="old_password" required>
            </li>
            <li>
                <br><label>Enter your new Profile password</label><br><br>
                <input type="password" id="password" name="new_password" required>
            </li>
            <li>
                <br><label>Enter your new Profile password</label><br><br>
                <input type="password" id="confirmPassword" name="confirm_password" required>
            </li>
            <br><br>
            <p id="message"></p>
            <br><br>
        </ul>
        <br><br>
        <% if (message) {%>
            <p style="color: red;">
                <%=message%>
            </p>
            <%}%>

                <br><br>
                <button type="submit">Update donor Password</button>
    </form>
</body>
<script>

    const form = document.getElementById("donorForm");

    function checkPassword() {

        const password =
            document.getElementById("password").value;

        const confirmPassword =
            document.getElementById("confirmPassword").value;

        const message =
            document.getElementById("message");

        if (password !== confirmPassword) {

            message.textContent = "Passwords do not match!";
            message.style.color = "red";

            return false;
        }

        message.textContent = "Passwords match!";
        message.style.color = "green";

        return true;
    }

    form.addEventListener("submit", function (event) {

        // Validate the new password and confirmation.
        if (!checkPassword()) {

            event.preventDefault();
            return;
        }
    })

    document.getElementById("password")
        .addEventListener("input", checkPassword);

    document.getElementById("confirmPassword")
        .addEventListener("input", checkPassword);
</script>

</html>