<!DOCTYPE html>

<html>

<head>

<title>Profile</title>

</head>

<body>

<h1>My Profile</h1>

<hr>

<p>Name : <%= user.name %></p>

<p>Email : <%= user.email %></p>

<p>Phone : <%= user.phone_number %></p>

<p>Gender : <%= user.gender %></p>

<p>DOB : <%= user.dob %></p>

<p>Age : <%= user.age !== null && user.age !== undefined ? user.age : 'N/A' %></p>

<p>Address : <%= user.address %></p>

<p>City : <%= user.city %></p>

<hr>

<a href="/dashboard">

Back to Dashboard

</a>

</body>

</html>
